oldwt/
storeart/

# The generated Xcode project. scaffold.sh rebuilds it from the pinned
# toolchain in packaging/ios/package.json, and it carries a copy of dist/
# inside it - so it is build output, not source. Anything the owner must set
# BY HAND in Xcode (signing, the bridging-header build setting, the IAP
# capability) is written down in packaging/ios/README.md instead, because a
# generated project cannot be trusted to preserve it.
packaging/ios/ios/

# The generated Android Studio project, the Android twin of packaging/ios/ios/:
# packaging/android/scaffold.sh rebuilds it from the pinned toolchain and it
# carries a copy of dist/. The plugin source, the config, the version and the
# icon script beside it ARE tracked.
packaging/android/android/

# THE SIGNING KEY, AND EVERYTHING SHAPED LIKE ONE.
# packaging/twa/ is a tracked folder and bubblewrap signs from inside it, so
# the keystore lives among tracked files - one `git add -A` away from being
# published to a public repository forever. It has never been committed; this
# is what keeps it that way.
android.keystore
*.keystore
*.jks
*.p12
packaging/twa/app-release-*.a*
packaging/twa/app-release-*.apk

# Launch trailer: the animatics are superseded by the final cuts and all
# regenerate (scripts/launch/trailer.mjs, scripts/launch/cut.mjs). Only the
# delivery set of final masters is committed (03-trailer/TRAILER.md).
docs/launch/assets/03-trailer/working/*.mp4
docs/launch/assets/03-trailer/final/*.mp4
